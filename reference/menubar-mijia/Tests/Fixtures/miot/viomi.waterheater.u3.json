{
  "description": "Water Heater",
  "services": [
    {
      "description": "Device Information",
      "iid": 1,
      "properties": [
        {
          "access": [
            "read"
          ],
          "description": "Device Manufacturer",
          "format": "string",
          "iid": 1,
          "type": "urn:miot-spec-v2:property:manufacturer:00000001:viomi-u3:1"
        },
        {
          "access": [
            "read"
          ],
          "description": "Device Model",
          "format": "string",
          "iid": 2,
          "type": "urn:miot-spec-v2:property:model:00000002:viomi-u3:1"
        },
        {
          "access": [
            "read"
          ],
          "description": "Device Serial Number",
          "format": "string",
          "iid": 3,
          "type": "urn:miot-spec-v2:property:serial-number:00000003:viomi-u3:1"
        },
        {
          "access": [
            "read"
          ],
          "description": "Current Firmware Version",
          "format": "string",
          "iid": 4,
          "type": "urn:miot-spec-v2:property:firmware-revision:00000005:viomi-u3:1"
        }
      ],
      "type": "urn:miot-spec-v2:service:device-information:00007801:viomi-u3:1"
    },
    {
      "description": "Water Heater",
      "iid": 2,
      "properties": [
        {
          "access": [
            "read",
            "write",
            "notify"
          ],
          "description": "Target Temperature",
          "format": "uint8",
          "iid": 1,
          "type": "urn:miot-spec-v2:property:target-temperature:00000021:viomi-u3:1",
          "unit": "celsius",
          "value-range": [
            30,
            65,
            1
          ]
        },
        {
          "access": [
            "read",
            "notify"
          ],
          "description": "Temperature",
          "format": "uint8",
          "iid": 2,
          "type": "urn:miot-spec-v2:property:temperature:00000020:viomi-u3:1",
          "unit": "celsius",
          "value-range": [
            0,
            255,
            1
          ]
        },
        {
          "access": [
            "read",
            "notify"
          ],
          "description": "Status",
          "format": "uint8",
          "iid": 3,
          "type": "urn:miot-spec-v2:property:status:00000007:viomi-u3:1",
          "unit": "none",
          "value-list": [
            {
              "description": "Off",
              "value": 0
            },
            {
              "description": "Idle",
              "value": 1
            },
            {
              "description": "Busy",
              "value": 2
            }
          ]
        },
        {
          "access": [
            "read",
            "write"
          ],
          "description": "Switch Status",
          "format": "bool",
          "iid": 4,
          "type": "urn:miot-spec-v2:property:on:00000006:viomi-u3:1"
        }
      ],
      "type": "urn:miot-spec-v2:service:water-heater:0000783E:viomi-u3:1"
    }
  ],
  "type": "urn:miot-spec-v2:device:water-heater:0000A02A:viomi-u3:1"
}
