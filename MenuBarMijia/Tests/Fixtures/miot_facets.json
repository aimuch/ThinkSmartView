{
  "version": 1,
  "cases": [
    {
      "id": "writable-bool-is-toggle",
      "spec": {
        "type": "urn:miot-spec-v2:device:outlet:00000000:fixture:1",
        "services": [
          {
            "iid": 2,
            "type": "urn:miot-spec-v2:service:switch:00000000:fixture:1",
            "properties": [
              {
                "iid": 1,
                "type": "urn:miot-spec-v2:property:on:00000000:fixture:1",
                "description": "Switch Status",
                "format": "bool",
                "access": ["read", "write", "notify"]
              }
            ]
          }
        ]
      },
      "expected": [
        {
          "id": "2.1",
          "kind": "toggle",
          "serviceId": 2,
          "serviceName": "switch",
          "propertyId": 1,
          "name": "on",
          "title": "Switch Status",
          "isWritable": true,
          "risk": "low",
          "writesByDefault": true,
          "highValue": false
        }
      ]
    },
    {
