# A USB drive's filesystem (a partition, or a whole disk without a partition table): mount it read-only
# for the screen (thinksmart-usb-mount@.service, stopped again when the drive goes away).
ACTION=="add", SUBSYSTEM=="block", ENV{ID_BUS}=="usb", ENV{ID_FS_USAGE}=="filesystem", TAG+="systemd", ENV{SYSTEMD_WANTS}+="thinksmart-usb-mount@%k.service"
