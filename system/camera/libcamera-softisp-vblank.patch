@@ -414,10 +414,20 @@ int AgcAlgorithm::configure(agc::Session &session, agc::ActiveState &state,
 	 * to know the limits for exposure time and analogue gain. As it depends
 	 * on the sensor, update it with the controls.
 	 *
-	 * \todo take VBLANK into account for maximum exposure time
+	 * The sensor's V4L2_CID_EXPOSURE maximum follows VBLANK (frame length
+	 * minus a margin), so the longest exposure is the one at the longest
+	 * frame. Pipelines that write VBLANK (frameContext.vblank) let the AGC
+	 * lower the frame rate in low light, down to the maximum of the
+	 * FrameDurationLimits control.
 	 */
+	const int32_t vblankDef = v4l2VBlank.def().get<int32_t>();
+	const int32_t vblankMax = v4l2VBlank.max().get<int32_t>();
+	session.sensor.exposureMargin =
+		std::max<int32_t>(0, static_cast<int32_t>(config.sensorInfo.outputSize.height) + vblankDef - maxExposure);
+	session.sensor.minVblank = v4l2VBlank.min().get<int32_t>();
+	session.sensor.maxVblank = vblankMax;
 	session.minExposureTime = minExposure * session.lineDuration;
-	session.maxExposureTime = maxExposure * session.lineDuration;
+	session.maxExposureTime = (maxExposure + std::max(0, vblankMax - vblankDef)) * session.lineDuration;
 	session.minAnalogueGain = minGain;
 	session.maxAnalogueGain = maxGain;
 	session.defAnalogueGain = defGain;
@@ -724,7 +734,10 @@ void AgcAlgorithm::process(const agc::Session &session, agc::ActiveState &state,
