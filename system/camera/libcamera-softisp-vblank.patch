-		processFrameDuration(session, frameContext, frameContext.minFrameDuration);
+		/* Keep the frame long enough for the exposure in use */
+		processFrameDuration(session, frameContext,
+				     std::max<utils::Duration>(frameContext.minFrameDuration,
+							       state.automatic.exposure * session.lineDuration));
 		fillMetadata(session, frameContext, metadata);
 		return;
 	}
@@ -852,8 +865,11 @@ void AgcAlgorithm::processFrameDuration(const agc::Session &session,
 {
 	const utils::Duration &lineDuration = session.lineDuration;
 
-	frameContext.vblank =
