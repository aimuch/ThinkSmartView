#!/bin/bash
# AirPlay (design board 49): install shairport-sync (3.3.8 on Ubuntu 24.04: classic AirPlay, MIT) from the
# Ubuntu archive the first time the page's 「安装」 is pressed. Online updates never install packages,
# so this is the one place that does, and only this package. The client runs it with sudo -n.
#   thinksmart-airplay-install status|install|on|off
# Prints one JSON line: {"installed": bool, "version": "..."}. The package's own system service is
# disabled: the client starts shairport-sync itself (output to stdout, into its background channel)
# only while 设置 › 网络 › AirPlay is on. The image masks avahi-daemon (mDNS, which AirPlay needs to be
# found); install unmasks it without enabling it, and on/off start and stop it with the switch.
# (idea from fubin0478/thinksmart-view, MIT)
set -u
AVAHI_CONF=/etc/avahi/avahi-daemon.conf
# the base image's avahi publishes nothing (disable-publishing=yes); AirPlay must publish its service
allow_publishing() {
    if grep -q '^disable-publishing=yes' "$AVAHI_CONF" 2>/dev/null; then
        sed -i 's/^disable-publishing=yes/disable-publishing=no/' "$AVAHI_CONF"
        systemctl try-restart avahi-daemon.service >/dev/null 2>&1 || true
    fi
}
status() {
    v=$(dpkg-query -W -f='${Status} ${Version}' shairport-sync 2>/dev/null | awk '$3 == "installed" {print $4}')
    if [ -n "$v" ]; then echo "{\"installed\": true, \"version\": \"$v\"}"; else echo '{"installed": false, "version": ""}'; fi
}
case "${1:-}" in
    status) status ;;
    install)
        export DEBIAN_FRONTEND=noninteractive
        if ! dpkg-query -W -f='${Status}' shairport-sync 2>/dev/null | grep -q 'ok installed'; then
            apt-get update -qq >&2 || { echo '没连上 Ubuntu 软件源' >&2; exit 1; }
            # --no-install-recommends: no extra sound servers; avahi-daemon is already there
            apt-get install -y -qq --no-install-recommends shairport-sync >&2 || { echo '没装上 shairport-sync' >&2; exit 1; }
            apt-get clean
            rm -rf /var/lib/apt/lists/*      # the image keeps no package lists (image/device-setup.sh)
        fi
        systemctl disable --now shairport-sync.service >/dev/null 2>&1 || true
        allow_publishing
        systemctl unmask avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
        systemctl disable avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
        status ;;
    on)
        allow_publishing
        systemctl unmask avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
        systemctl start avahi-daemon.service || { echo '没开起 avahi-daemon' >&2; exit 1; }
        status ;;
    off)
        systemctl stop avahi-daemon.service avahi-daemon.socket >/dev/null 2>&1 || true
        status ;;
    *) echo "usage: thinksmart-airplay-install status|install|on|off" >&2; exit 2 ;;
esac
